# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT="3000"

# JWT_SECRET: Strong random cryptographic secret key for signing user sessions and auth tokens.
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_TO_A_CRYPTOGRAPHIC_RANDOM_STRING"

# ADMIN_EMAIL: Configured administrator account email.
ADMIN_EMAIL="plus10@gmail.com"

# ADMIN_INITIAL_PASSWORD: Temporary initial administrator password for first-time seed.
# The administrator is forced to update this password on first login.
ADMIN_INITIAL_PASSWORD="creativity"

# DATABASE_PATH: Path to SQLite database file.
DATABASE_PATH="./data/pulsefeedback.db"
